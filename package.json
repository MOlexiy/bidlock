{
  "name": "bidlock",
  "private": true,
  "version": "0.1.0",
  "description": "Real-time auction with concurrency-safe bidding and balance freezing",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:migrate": "npm run migrate -w api",
    "db:seed": "npm run seed -w api",
    "dev:api": "npm run dev -w api",
    "dev:web": "npm run dev -w web",
    "test": "npm run test -w api",
    "stress": "npm run stress -w api --",
    "build": "npm run build -w api && npm run build -w web"
  },
  "engines": {
    "node": ">=20"
  }
}
