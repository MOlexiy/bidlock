# apps/api reads these (copy to apps/api/.env)
PORT=3000
DATABASE_URL=postgres://bidlock:bidlock@localhost:5432/bidlock
DATABASE_URL_TEST=postgres://bidlock:bidlock@localhost:5432/bidlock_test
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me
# Telegram MiniApp auth (optional). Leave empty to disable /auth/telegram.
TELEGRAM_BOT_TOKEN=
# Dev login by username + faucet. Disable in production.
ALLOW_DEV_LOGIN=true
